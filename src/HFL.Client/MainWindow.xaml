<Window x:Class="HFL.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HFL Razbloker Enterprise" 
        Height="620" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#080C14"
        Foreground="#F8FAFC">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Big Power Button -->
        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="OuterRing" Stroke="#0EA5E9" StrokeThickness="4" Fill="#0F172A">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#0EA5E9" BlurRadius="25" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🛡️ HFL Razbloker" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ENTERPRISE" FontSize="10" FontWeight="Bold" Foreground="#0EA5E9"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="LicenseBadge" Background="#13271F" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                    <TextBlock x:Name="LicenseText" Text="🟢 Лицензия: Активна" FontSize="12" Foreground="#34D399" FontWeight="Medium"/>
                </Border>
                <Button Content="⚙️ Настройки" Background="#1E293B" Foreground="#94A3B8" Padding="10,6" Click="SettingsButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Power Button & Mode -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,12,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    
                    <!-- Circular Power Toggle -->
                    <Button x:Name="TogglePowerButton" Style="{StaticResource PowerButtonStyle}" Click="TogglePower_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="PowerIcon" Text="⚡" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="PowerButtonText" Text="ВКЛЮЧИТЬ" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="ConnectionStatusText" Text="Отключено" FontSize="14" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,18,0,14"/>

                    <!-- Mode Selector -->
                    <TextBlock Text="Режим работы:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ModeComboBox" Height="36" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="⚡ Автономный («Швейцарские часы»)" IsSelected="True"/>
                        <ComboBoxItem Content="🛡️ Zapret DPI Bypass (Прямой обход)"/>
                        <ComboBoxItem Content="🌐 3X-UI Enterprise VPN (VLESS Reality)"/>
                        <ComboBoxItem Content="🔒 Свой DoH / DNS Резолвер"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Right Column: Real-time Live Metrics -->
            <Border Grid.Column="1" Background="#0F172A" CornerRadius="12" Padding="20" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📊 Мониторинг сети в реальном времени" FontSize="14" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,14"/>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Ping / Latency -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#131D2F" CornerRadius="8" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="📶 Задержка (Пинг)" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PingText" Text="— ms" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                                <TextBlock Text="Цель: &lt; 80 мс (Швейцарские часы)" FontSize="10" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Active Strategy -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#131D2F" CornerRadius="8" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="🎯 Активная стратегия" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="StrategyText" Text="Отключено" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: YouTube 4K -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#131D2F" CornerRadius="8" Padding="14" Margin="0,8,8,8">
                            <StackPanel>
                                <TextBlock Text="▶️ YouTube 4K Stream" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="YoutubeStatusText" Text="⚪ Не проверено" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Discord Voice -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#131D2F" CornerRadius="8" Padding="14" Margin="8,8,0,8">
                            <StackPanel>
                                <TextBlock Text="🎙️ Discord Voice &amp; Gateway" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="DiscordStatusText" Text="⚪ Не проверено" FontSize="13" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Local / Internal Domains -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#131D2F" CornerRadius="8" Padding="14" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🌐 Локальные зоны (.local / .internal)" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="Автоматический резолвинг внутренних сайтов через DoH" FontSize="12" Foreground="#38BDF8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="🟢 Доступны" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Real-time Console Log -->
        <Border Grid.Row="2" Background="#06090E" CornerRadius="8" Padding="12" BorderBrush="#1E293B" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🖥️ Журнал работы автономного ядра:" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" Background="Transparent" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
